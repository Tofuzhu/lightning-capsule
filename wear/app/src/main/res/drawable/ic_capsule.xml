<!--
  Monochrome capsule glyph for the complication (MONOCHROMATIC_IMAGE / SMALL_IMAGE
  ICON) and the Wear Widget. White on a transparent background so the watch face
  can tint it. A horizontal capsule "pill" with a lightning bolt punched out
  (evenOdd) — matches the app's "闪念胶囊 / Lightning Capsule" identity.

  The pill is drawn deliberately squat and full-bleed (touches both viewport
  edges) with a wide straight midsection, and the bolt cutout is large with a
  chunky stroke, so the glyph stays legible when a watch face tints it a
  low-contrast grey.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M7,5 L17,5 A7,7 0 0 1 17,19 L7,19 A7,7 0 0 1 7,5 Z M14.5,6 L8,13.2 L11.3,13.2 L9.5,18 L16,10.8 L12.7,10.8 Z" />
</vector>
